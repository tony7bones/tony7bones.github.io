<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.tony7bones.bootstrap"
       name="Tony.7.Bones Setup"
       version="1.2.0"
       provider-name="tony7bones">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
    <import addon="xbmc.addon" version="12.0.0"/>
    <import addon="script.module.tony7bones" version="1.1.0"/>
  </requires>
  <!--
    A normal runnable Program add-on. It does not linger on the home screen
    because it removes ITSELF at the end of a successful run (see default.py:
    _self_uninstall) — run once from the repo, then it deletes its own add-on
    directory and the end-of-setup restart de-registers it from Kodi's add-on
    database. Reinstall any time from Install from repository > Tony.7.Bones Repo.
  -->
  <extension point="xbmc.python.script" library="default.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <platform>all</platform>
    <language/>
    <license>GPL-2.0-or-later</license>
    <summary lang="en_GB">Tony.7.Bones Kodi Setup</summary>
    <description lang="en_GB">Installs repositories and add-ons for a personal Kodi build.</description>
    <news>v1.2.0: One-tap onboarding — video add-ons (POV, The Loop, Sports HD) now install automatically with no picker or prompt. The standalone Video Add-ons Setup is retired and its install logic folded into the shared library; Umbrella is no longer installed. One combined summary, one restart, fully unattended.</news>
  </extension>
</addon>
