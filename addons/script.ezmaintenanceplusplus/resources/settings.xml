		<category id="backup_restore" label="Backup/Restore">
			<group id="1">
				<setting id="BackupFixSpecialHome" type="boolean" label="Replace home folder in xml files with special://home">
					<level>0</level>
					<default>false</default>
					<control type="toggle" />
				</setting>
				<setting id="destination" type="integer" label="Destination">
					<level>0</level>
					<default>0</default>
					<constraints>
						<options>
							<option label="Local">0</option>
							<option label="Network (SMB/NFS)">1</option>
							<option label="Dropbox">2</option>
						</options>
					</constraints>
					<control type="spinner" format="string" />
				</setting>
				<setting id="backup.keep" type="integer" label="Keep how many backups (0 = keep all)">
					<level>0</level>
					<default>5</default>
					<constraints>
						<minimum>0</minimum>
						<step>1</step>
						<maximum>50</maximum>
					</constraints>
					<control type="slider" format="integer" />
				</setting>
				<setting id="download.path" type="path" label="Backup Location">
					<level>0</level>
					<default></default>
					<constraints>
						<allowempty>true</allowempty>
						<sources>
							<source>files</source>
						</sources>
					</constraints>
					<dependencies>
						<dependency type="visible" setting="destination" operator="!is">2</dependency>
					</dependencies>
					<control type="button" format="path">
						<heading>Backup Location</heading>
					</control>
				</setting>
				<setting id="restore.path" type="path" label="Restore from Zip Location (folder)">
					<level>0</level>
					<default></default>
					<constraints>
						<allowempty>true</allowempty>
						<sources>
							<source>files</source>
						</sources>
					</constraints>
					<dependencies>
						<dependency type="visible" setting="destination" operator="!is">2</dependency>
					</dependencies>
					<control type="button" format="path">
						<heading>Restore from Zip Location (folder)</heading>
					</control>
				</setting>
				<setting id="dropbox_signin" type="action" label="Sign in to Dropbox">
					<level>0</level>
					<default></default>
					<dependencies>
						<dependency type="visible" setting="destination">2</dependency>
					</dependencies>
					<control type="button" format="action">
						<data>RunScript(script.ezmaintenanceplusplus,authorize)</data>
					</control>
				</setting>
				<setting id="dropbox_key" type="string" label="Dropbox App key (advanced - only if not signing in normally)">
					<level>0</level>
					<default></default>
					<constraints>
						<allowempty>true</allowempty>
					</constraints>
					<dependencies>
						<dependency type="visible" setting="destination">2</dependency>
					</dependencies>
					<control type="edit" format="string">
						<heading>Dropbox App key (advanced - only if not signing in normally)</heading>
					</control>
				</setting>
				<setting id="dropbox_secret" type="string" label="Dropbox App secret (advanced)">
					<level>0</level>
					<default></default>
					<constraints>
						<allowempty>true</allowempty>
					</constraints>
					<dependencies>
						<dependency type="visible" setting="destination">2</dependency>
					</dependencies>
					<control type="edit" format="string">
						<heading>Dropbox App secret (advanced)</heading>
					</control>
				</setting>
				<setting id="dropbox_refresh_token" type="string">
					<level>0</level>
					<default></default>
					<constraints>
						<allowempty>true</allowempty>
					</constraints>
					<visible>false</visible>
					<control type="edit" format="string" />
				</setting>
			</group>
		</category>
