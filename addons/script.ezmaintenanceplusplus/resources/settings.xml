<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings version="1">
	<section id="script.ezmaintenanceplusplus">
		<category id="maintenance" label="Maintenance">
			<group id="1">
				<setting id="notify_mode" type="boolean" label="Show Stats at Startup">
					<level>0</level>
					<default>false</default>
					<control type="toggle" />
				</setting>
			</group>
			<group id="2" label="AutoClean">
				<setting id="startup.cache" type="boolean" label="AutoClean Cache at Startup">
					<level>0</level>
					<default>true</default>
					<control type="toggle" />
				</setting>
				<setting id="autoCleanDays" type="integer" label="AutoClean Cache Every Number of Days (0 is Not)">
					<level>0</level>
					<default>0</default>
					<constraints>
						<minimum>0</minimum>
						<step>1</step>
						<maximum>365</maximum>
					</constraints>
					<control type="slider" format="integer" />
				</setting>
				<setting id="autoCleanHour" type="integer" parent="autoCleanDays" label="AutoClean Cache at Hour (0-12 = AM / 12-23 = PM)">
					<level>0</level>
					<default>4</default>
					<constraints>
						<minimum>0</minimum>
						<step>1</step>
						<maximum>23</maximum>
					</constraints>
					<dependencies>
						<dependency type="enable" setting="autoCleanDays" operator="!is">0</dependency>
					</dependencies>
					<control type="slider" format="integer" />
				</setting>
			</group>
			<group id="3" label="Package Folder Limits">
				<setting id="filesize_alert" type="integer" label="Max Total Files Size (MB)">
					<level>0</level>
					<default>200</default>
					<constraints>
						<minimum>25</minimum>
						<step>1</step>
						<maximum>500</maximum>
					</constraints>
					<control type="slider" format="integer" />
				</setting>
				<setting id="packagenumbers_alert" type="integer" label="Max Number of Zip Files">
					<level>0</level>
					<default>50</default>
					<constraints>
						<minimum>5</minimum>
						<step>1</step>
						<maximum>200</maximum>
					</constraints>
					<control type="slider" format="integer" />
				</setting>
			</group>
			<group id="4" label="Thumbnails Folder Limits">
				<setting id="filesizethumb_alert" type="integer" label="Max Total Files Size (MB)">
					<level>0</level>
					<default>500</default>
					<constraints>
						<minimum>50</minimum>
						<step>1</step>
						<maximum>2000</maximum>
					</constraints>
					<control type="slider" format="integer" />
				</setting>
			</group>
		</category>

