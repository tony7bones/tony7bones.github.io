#!/bin/sh
# Auto-build on commit, so the whole workflow is: edit dropbox/ -> commit -> push.
#
#   1. Compile the pristine sources -> the Pages-served tree (generate_repo.py):
#      dropbox/ -> repo ROOT (1:1 canvas mirror + Kodi indexes), addons/ -> built
#      zips + addons.xml. The proxy installer is injected into the SERVED
#      repositories/ by the generator (dropbox/ is never written to).
#   2. Stage the pristine sources you edited + the regenerated served output —
#      scoped to known paths, never a blanket `git add -A`, so an unrelated
#      untracked file is never swept into the commit.
#
# generate_repo.py is deterministic/idempotent, so on a commit that didn't touch
# dropbox/ or addons/ this is a no-op beyond staging what you already changed.
set -e
cd "$(git rev-parse --show-toplevel)"

# 1. compile sources -> served tree
python3 _tools/generate_repo.py >/dev/null

# 2. stage the sources + the generated output (scoped; no blanket git add -A)
git add -A -- dropbox addons index.html repository.tony7bones-*.zip
# each served canvas dir is a generated mirror of a dropbox/ subfolder
if [ -d dropbox ]; then
  for d in dropbox/*/; do
    name=$(basename "$d")
    [ -e "$name" ] && git add -A -- "$name"
  done
fi
