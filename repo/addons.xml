<?xml version='1.0' encoding='UTF-8'?>
<addons>
    <addon id="repository.tony7bones" name="Tony.7.Bones Repo" provider-name="Tony.7.Bones" version="1.0.8">
        <requires>
            <import addon="xbmc.python" version="3.0.0" />
        </requires>
        <extension point="xbmc.addon.repository">
            <dir>
                <info>http://127.0.0.1:61234/addons.xml</info>
                <checksum>http://127.0.0.1:61234/addons.xml.md5</checksum>
                <datadir>http://127.0.0.1:61234/</datadir>
            </dir>
        </extension>
        <extension point="xbmc.python.script" library="default.py" />
        <extension point="xbmc.service" library="service.py" />
        <extension point="xbmc.addon.metadata">
            <platform>all</platform>
            <license>See https://github.com/i96751414/repository.github/blob/master/LICENSE</license>
            <source>https://github.com/i96751414/repository.github</source>
            <summary lang="en">Welcome to Tony.7.Bones repository. Enjoy!</summary>
            <description lang="en">Welcome to Tony.7.Bones repository. Enjoy!</description>
            <news>
v1.0.8: Rename repository to Tony.7.Bones Repo
        </news>
            <assets>
                <icon>icon.png</icon>
            </assets>
        </extension>
    </addon>
    <addon id="script.tony7bones.bootstrap" name="Tony.7.Bones Setup" version="1.0.17" provider-name="tony7bones">
        <requires>
            <import addon="xbmc.python" version="3.0.0" />
            <import addon="xbmc.addon" version="12.0.0" />
        </requires>
        <extension point="xbmc.python.script" library="default.py">
            <provides>executable</provides>
        </extension>
        <extension point="xbmc.addon.metadata">
            <platform>all</platform>
            <language />
            <license>GPL-2.0-or-later</license>
            <summary lang="en_GB">Tony.7.Bones Kodi Setup</summary>
            <description lang="en_GB">Installs repositories and add-ons for a personal Kodi build.</description>
            <news>v1.0.17: Adds Multi Weather and IPTV Simple Client (binary PVR, platform-correct build auto-selected) to the install set, and removes the unknown-sources toggle entirely so no security prompt ever appears. (v1.0.14 fixed the "Registering add-ons" freeze: apps and their full dependency closure are resolved from the repos and extracted directly, then enabled, so installs run prompt-free and the add-ons actually function.)</news>
        </extension>
    </addon>
    <addon id="script.tony7bones.modv2.patch" name="Estuary MOD V2 Patch" version="1.0.3" provider-name="tony7bones">
        <requires>
            <import addon="xbmc.python" version="3.0.0" />
        </requires>
        <extension point="xbmc.python.script" library="default.py" />
        <extension point="xbmc.addon.metadata">
            <summary lang="en_GB">Apply tony7bones logo and breadcrumb fixes to Estuary MOD V2</summary>
            <description lang="en_GB">Replaces the MOD V2 logo with the standard Estuary wordmark (vendor_logo.png) and restores section labels in the top bar. Run this after installing or updating skin.estuary.modv2. Safe to re-run — original files are backed up once and never overwritten.</description>
            <platform>all</platform>
        </extension>
    </addon>
</addons>