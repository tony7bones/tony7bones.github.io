<?xml version='1.0' encoding='UTF-8'?>
<addons>
    <addon id="repository.tony7bones" name="Tony7Bones Repository" version="1.0.5" provider-name="tony7bones">
        <extension point="xbmc.addon.repository" name="Tony7Bones Repository">
            <dir>
                <info compressed="false">https://raw.githubusercontent.com/tony7bones/tony7bones.github.io/main/repo/addons.xml</info>
                <checksum>https://raw.githubusercontent.com/tony7bones/tony7bones.github.io/main/repo/addons.xml.md5</checksum>
                <datadir zip="true">https://raw.githubusercontent.com/tony7bones/tony7bones.github.io/main/repo/</datadir>
                <hashes>false</hashes>
            </dir>
        </extension>
        <extension point="xbmc.addon.metadata">
            <platform>all</platform>
            <summary lang="en_GB">Tony7Bones Kodi Repository</summary>
            <description lang="en_GB">Official repository for Tony7Bones Kodi addons.</description>
            <news>v1.0.5: Self-list in addons.xml, raw.githubusercontent.com URLs, disable hash checks.</news>
        </extension>
    </addon>
    <addon id="script.tony7bones.bootstrap" name="Tony 7 Bones Setup" version="1.0.4" provider-name="tony7bones">
        <requires>
            <import addon="xbmc.python" version="3.0.0" />
            <import addon="xbmc.addon" version="12.0.0" />
        </requires>
        <extension point="xbmc.python.script" library="default.py">
            <provides>executable</provides>
        </extension>
        <extension point="xbmc.addon.metadata">
            <platform>all</platform>
            <language />
            <license>GPL-2.0-or-later</license>
            <summary lang="en_GB">Tony 7 Bones Kodi Setup</summary>
            <description lang="en_GB">Installs repositories and add-ons for a personal Kodi build.</description>
            <news>v1.0.4: Add Network 24 as second IPTV Simple Client instance.</news>
        </extension>
    </addon>
</addons>