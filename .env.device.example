# ──────────────────────────────────────────────────────────────────────────────
#  Tony.7.Bones — per-device box config TEMPLATE.
#
#  Copy this to .env.<device> (e.g. .env.bedroom) and fill in real values, then
#  provision with `_tools/provision-kodi.sh <device>`. The real .env.<device>
#  files are GITIGNORED (they carry provider creds + API keys) — only THIS example
#  is committed. Master values live in ~/.dotfiles/VAULT.md. Absent on a box → the
#  bootstrap falls back to keyless-Yahoo weather defaults.
# ──────────────────────────────────────────────────────────────────────────────

# ── Box identity & connection ──────────────────────────────────────────────────
DEVICE_NAME="Living Room"            # shown as the Kodi device name
DEVICE_IP="192.168.1.100"           # the box's LAN IP (adb + JSON-RPC target)
# Kodi data dir on the box. Keep this default for a standard Android box. For a
# NON-ROOTED Fire OS 11 Stick (adb can't write the app sandbox) set the relocated
# path  "/sdcard/kodi_data/.kodi"  — the provisioner then writes xbmc_env.properties
# to move Kodi's data into writable storage. See:
#   docs/playbooks/firetv-stick-scoped-storage-provisioning.md
KODI_DATA_PATH="/sdcard/Android/data/org.xbmc.kodi/files/.kodi"

# ── Kodi remote control  (phone remotes: Kore / Yatse) ─────────────────────────
KODI_WEB_USER="kodi"
KODI_WEB_PASS="kodi"                 # CHANGE ME
KODI_WEB_PORT="8080"
KODI_REMOTE_CONTROL="true"           # control from THIS + OTHER systems on; auth OFF, SSL OFF

# ── UI ─────────────────────────────────────────────────────────────────────────
SETTINGS_LEVEL="expert"              # Standard | Advanced | Expert

# ── Weather  (Multi Weather / weather.multi) ───────────────────────────────────
#  Up to 5, in display order. City names OR zipcodes — Yahoo resolves both.
WEATHER_LOCATIONS="Sacramento; New York; Chicago; Denver; Seattle"
WEATHERBIT_API_KEY="your_weatherbit_api_key"      # optional "Additional" layer
OWM_API_KEY="your_openweathermap_api_key"         # optional "Maps" layer

# ── IPTV  (pvr.iptvsimple — provider creds are SECRET) ─────────────────────────
IPTV_NAME="My Provider"
IPTV_M3U="http://provider.example:8080/get.php?username=USER&password=PASS&type=m3u_plus&output=ts"
IPTV_EPG="http://provider.example:8080/xmltv.php?username=USER&password=PASS"
IPTV_GROUPS="USA ENTERTAINMENT; USA NEWS/WEATHER; PPV EVENTS"   # custom TV groups, in order
IPTV_GROUPS_ONLY="true"              # "Only load TV channels in groups"

# ── RSS news ticker ────────────────────────────────────────────────────────────
RSS_INTERVAL="30"                    # seconds between headlines
RSS_FEEDS="https://feeds.example.com/news.xml; https://feeds.example.com/sports.xml"
